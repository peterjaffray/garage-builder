PORT=3000

# DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=garage_estimator
DB_USER=postgres
DB_PASSWORD=postgres

# SMTP config for email
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=info@northlandbuildingsupplies.ca
SMTP_PASS=supersecret

# Email sender/recipient (comma-separated for multiple recipients)
MAIL_FROM=info@northlandbuildingsupplies.ca
MAIL_TO=sales@northlandbuildingsupplies.ca

# Google reCAPTCHA (if used)
RECAPTCHA_SECRET=your-recaptcha-secret

# Lead sheet ledger (Google Sheets, dedicated service account)
SHEET_ID=your-spreadsheet-id
SHEET_TAB=Forms Submitted
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/sheets-key.json

# Shared secret the WordPress mu-plugin must send in X-Ingest-Secret to POST /ingest
INGEST_SHARED_SECRET=your-shared-secret